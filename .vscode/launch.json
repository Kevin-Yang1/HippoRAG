{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: main.py (2wikimultihopqa)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "args": [
                "--dataset", "2wikimultihopqa",
                "--llm_name", "meta-llama/Llama-3.1-8B-Instruct",
                "--llm_base_url", "http://222.20.98.85:6578/v1",
                // "--llm_base_url", "http://localhost:6578/v1",
                "--openie_mode", "online"
            ],
            "env": {
                "OPENAI_API_KEY": "EMPTY",
                "CUDA_VISIBLE_DEVICES": "1",
                "HF_ENDPOINT": "https://hf-mirror.com",
                "LD_LIBRARY_PATH": "/home/ykw/miniconda3/envs/hipporag/lib/python3.10/site-packages/nvidia/nvjitlink/lib:${env:LD_LIBRARY_PATH}"
            }
        },
        {
            "name": "Python: main.py (2wikimultihopqa_dev)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "args": [
                "--dataset", "2wikimultihopqa_dev",
                "--index_dir", "outputs/2wikimultihopqa",
                "--llm_name", "meta-llama/Llama-3.1-8B-Instruct",
                "--llm_base_url", "http://222.20.98.85:6578/v1",
                // "--llm_base_url", "http://localhost:6578/v1",
                "--openie_mode", "online"
            ],
            "env": {
                "OPENAI_API_KEY": "EMPTY",
                "CUDA_VISIBLE_DEVICES": "1",
                "HF_ENDPOINT": "https://hf-mirror.com",
                "LD_LIBRARY_PATH": "/home/ykw/miniconda3/envs/hipporag/lib/python3.10/site-packages/nvidia/nvjitlink/lib:${env:LD_LIBRARY_PATH}"
            }
        },
        {
            "name": "Python: demo_local.py (with NVIDIA libs)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/demo_local.py",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env"
        }
    ]
}